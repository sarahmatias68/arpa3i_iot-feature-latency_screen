    {
        "id": "func_proxy_granular",
        "type": "function",
        "z": "tab_app_v9_toolbar",
        "g": "group_proxy_granular",
        "name": "Proxy Logic (IP 192.168.2.131)",
        "func": "// Configuração do ESP32\nconst ESP32_IP = \"192.168.2.131\";\nconst ESP32_PORT = \"86\";\n\n// Monta a URL (preserva query params e subpaths)\nmsg.url = `http://${ESP32_IP}:${ESP32_PORT}${msg.req.url}`;\nmsg.method = msg.req.method;\n\n// Headers Essenciais (Allowlist)\nconst allowed = ['content-type','authorization','accept','user-agent','x-api-key'];\nconst h = {};\nif(msg.req.headers) {\n    allowed.forEach(k => { if(msg.req.headers[k]) h[k] = msg.req.headers[k]; });\n}\n\n// Corrige Content-Type para POSTs\nif (!h['content-type'] && (msg.method === 'POST' || msg.method === 'PUT')) {\n    h['content-type'] = 'application/json';\n}\n\nmsg.headers = h;\nmsg.payload = msg.req.body;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 840,
        "wires": [
            [
                "http_req_granular"
            ]
        ]
    },
