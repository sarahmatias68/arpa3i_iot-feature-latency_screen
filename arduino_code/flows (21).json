    {
        "id": "format_notification",
        "type": "function",
        "z": "tab_app_v9_toolbar",
        "name": "Formatar Notificação",
        "func": "var tokensMap = msg.payload; \nvar listaTokens = Object.keys(tokensMap);\nvar dadosOriginais = msg.dadosAlerta || {};\nvar tituloAlerta = dadosOriginais.type ? \"⚠️ \" + dadosOriginais.type : \"⚠️ ALERTA ARPA3i\";\nvar corpoAlerta = dadosOriginais.message || \"Evento detectado no sistema.\";\nvar mensagensParaEnviar = [];\n\nlistaTokens.forEach(function(token) {\n    if (token && token.length > 20) { \n        var msgIndividual = {\n            payload: {\n                token: token,\n                notification: {\n                    title: tituloAlerta,\n                    body: corpoAlerta\n                },\n                data: {\n                    type: dadosOriginais.type || \"ALERTA\",\n                    local: \"Residencia\"\n                },\n                android: {\n                    priority: \"high\",\n                    notification: {\n                        sound: \"default\",\n                        channelId: \"high_importance_channel\"\n                    }\n                }\n            }\n        };\n        mensagensParaEnviar.push(msgIndividual);\n    }\n});\nreturn [mensagensParaEnviar];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 60,
        "wires": [
            [
                "firebase_send"
            ]
        ]
    },
