    {
        "id": "status_logic_text",
        "type": "function",
        "z": "tab_app_v9_toolbar",
        "name": "Status para Texto Colorido",
        "func": "var estado = msg.payload.payload.estado;\n\n// Configuração Padrão\nmsg.payload = \"DESCONHECIDO\";\nmsg.bgcolor = \"gray\";\nmsg.color = \"white\";\nmsg.icon = \"fa-question\";\n\n// IMPORTANTE: Deixar true para a cor ficar 100% sólida (se false, fica transparente/rosa)\nmsg.enabled = true; \n\nif (estado === \"FECHADO\") {\n    msg.payload = \"PORTÃO FECHADO\";\n    // Vermelho 100% Puro\n    msg.bgcolor = \"#FF0000\"; \n    msg.icon = \"fa-lock\";\n} \nelse if (estado === \"ABERTO\") {\n    msg.payload = \"PORTÃO ABERTO\";\n    // Verde Puro (Neon)\n    msg.bgcolor = \"#00C853\"; \n    msg.icon = \"fa-unlock\";\n} \nelse if (estado === \"EM_MOVIMENTO\") {\n    msg.payload = \"MOVENDO...\";\n    // Amarelo Ouro\n    msg.bgcolor = \"#FFD600\"; \n    msg.color = \"black\"; \n    msg.icon = \"fa-arrows-v\";\n} \nelse if (estado === \"ACIONADO\") {\n    msg.payload = \"COMANDO ENVIADO\";\n    // Azul Royal\n    msg.bgcolor = \"#2962FF\"; \n    msg.icon = \"fa-circle-o-notch fa-spin\";\n}\n\nreturn msg;",
